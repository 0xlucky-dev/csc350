{
  "name": "@ninja-shop/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./types": "./src/types/index.ts",
    "./validators": "./src/validators/index.ts",
    "./db": "./src/db/client.ts"
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "db:seed": "node -r dotenv/config -r tsx/register src/db/seed.ts",
    "db:import-games": "tsx src/db/import-games.ts",
    "db:clean-games": "tsx src/db/clean-games.ts",
    "db:testdb": "node src/db/testdb.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "mysql2": "^3.9.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.5",
    "fast-check": "^3.15.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
