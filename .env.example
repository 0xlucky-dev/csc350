# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=ninja_shop

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production

# Internal URL สำหรับ server-side fetch
# ใช้ localhost:port เสมอ (ไม่ผ่าน nginx)
# Customer app จะ fetch API ตัวเองผ่าน URL นี้
INTERNAL_BASE_URL=http://localhost:7000

# Public URLs (optional - สำหรับ production)
# NEXT_PUBLIC_CUSTOMER_URL=https://app.yourdomain.com
# NEXT_PUBLIC_ADMIN_URL=https://admin.yourdomain.com
